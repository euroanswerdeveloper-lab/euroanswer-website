---
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import { Image } from 'astro:assets';
import logo from '../assets/home/logo.jpg';
import { ui, homeUrl, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  image?: string;
  // Variantele aceleiași pagini în alte limbi (pentru hreflang), ex. { en: '/', de: '/de/...', ru: '/ru/...' }
  alternates?: Partial<Record<Lang, string>>;
}
const { title, description, lang = 'en', image = '/og-image.jpg', alternates } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Versiune de test (ex. pe alt domeniu): PUBLIC_NOINDEX=true la build → paginile nu sunt indexate
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true';
const l = (lang in ui ? lang : 'en') as Lang;
const t = ui[l];
const home = homeUrl[l];
const languageNames: Record<Lang, string> = { en: 'English', de: 'Deutsch', ru: 'Русский' };

// Date structurate despre companie (Schema.org) — ajută Google și asistenții AI să înțeleagă cine suntem.
// Păstrează aceste date identice cu cele de pe site și din directoare (GoodFirms, Clutch etc.).
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://www.euroanswer.co.uk/#organization',
  name: 'Euroanswer',
  url: 'https://www.euroanswer.co.uk/',
  logo: 'https://www.euroanswer.co.uk/logo.jpg',
  description: 'Boutique BPO company providing multilingual customer service outsourcing, technical support and staffing services in 20+ languages from delivery centres in Bucharest, Galati and Skopje.',
  foundingDate: '2004',
  founder: { '@type': 'Person', name: 'Marian Raianu', jobTitle: 'CEO & Founder', sameAs: 'https://www.linkedin.com/in/marian-raianu-340398/' },
  email: 'office@euroanswer.co.uk',
  telephone: '+40317305000',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '28 Dr. Iacob Felix St, 1st Floor, District 1',
    postalCode: '011038',
    addressLocality: 'Bucharest',
    addressCountry: 'RO',
  },
  location: [
    { '@type': 'Place', name: 'Euroanswer Bucharest', address: { '@type': 'PostalAddress', streetAddress: '28 Dr. Iacob Felix St, 1st Floor', postalCode: '011038', addressLocality: 'Bucharest', addressCountry: 'RO' } },
    { '@type': 'Place', name: 'Euroanswer Galati', address: { '@type': 'PostalAddress', streetAddress: 'B-dul Siderurgiștilor 7, tronson 2, Bloc PS1B', addressLocality: 'Galati', addressCountry: 'RO' } },
    { '@type': 'Place', name: 'Euroanswer Skopje', address: { '@type': 'PostalAddress', streetAddress: '1-1/40 Stoltenbergova St', addressLocality: 'Skopje', addressCountry: 'MK' } },
  ],
  knowsLanguage: ['en', 'de', 'fr', 'it', 'es', 'ro', 'el', 'hu', 'fi', 'nl', 'pl', 'cs', 'sk', 'bg', 'mk', 'sq', 'sr', 'ru', 'tr', 'ar'],
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', name: 'ISO 9001' },
    { '@type': 'EducationalOccupationalCredential', name: 'ISO/IEC 27001' },
  ],
  sameAs: [
    'https://www.linkedin.com/company/2446824',
    'https://www.facebook.com/Euroanswer/',
    'https://twitter.com/euroanswer',
    'https://www.instagram.com/euroanswer/',
  ],
};

// Cele două mari categorii de servicii (textele sunt în src/i18n/ui.ts)
const services = t.serviceItems;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />}
    {noindex && <meta name="googlebot" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates && Object.entries(alternates).map(([code, href]) => (
      <link rel="alternate" hreflang={code} href={new URL(href, Astro.site)} />
    ))}
    {alternates?.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Euroanswer" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="topbar">
      <div class="container">
        <div class="contact">
          <a href="tel:+40317305000">+40 317 305 000</a>
          <a href="mailto:office@euroanswer.co.uk">office@euroanswer.co.uk</a>
        </div>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a href={home} class="logo" aria-label="Euroanswer home">
          <Image src={logo} alt="Euroanswer" height={42} loading="eager" />
        </a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">{t.menu}</button>
        <nav class="main-nav" id="main-nav">
          <a href={home}>{t.home}</a>
          <a href="/about-us/">{t.about}</a>
          <div class="dropdown">
            <span tabindex="0">{t.services} ▾</span>
            <div class="dropdown-menu">
              {services.map((s) => (
                <a href={s.href}>{s.label}<small>{s.note}</small></a>
              ))}
            </div>
          </div>
          <a href="/insights/">{t.insights}</a>
          <a href="/blog/">{t.blog}</a>
          <a href="/join-the-team/">{t.join}</a>
          <a href={t.contactUrl}>{t.contact}</a>
          <details class="lang-dd">
            <summary aria-label="Language">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
              <span>{l.toUpperCase()}</span>
              <span class="caret" aria-hidden="true">▾</span>
            </summary>
            <ul>
              {(Object.keys(homeUrl) as Lang[]).map((code) => (
                <li>
                  <a href={alternates?.[code] ?? homeUrl[code]} hreflang={code} lang={code} aria-current={code === l ? 'true' : undefined}>
                    <b>{code.toUpperCase()}</b> {languageNames[code]}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a href={home} class="footer-logo"><Image src={logo} alt="Euroanswer" height={24} /></a>
            <p>{t.footerAbout}</p>
            <ul class="footer-policies">
              <li><a href="/about-us/#quality-policy">{t.qualityPolicy}</a></li>
              <li><a href="/euroanswer-data-protection-privacy-policy/">{t.privacyPolicy}</a></li>
            </ul>
          </div>
          <div>
            <h4>{t.footerServices}</h4>
            {services.map((s) => <p><a href={s.href}>{s.label}</a></p>)}
            <p><a href={`${home}#industries`}>{t.industries}</a></p>
          </div>
          <div>
            <h4>{t.company}</h4>
            <p><a href="/about-us/">{t.about}</a></p>
            <p><a href="/insights/">{t.insights}</a></p>
            <p><a href="/blog/">{t.blog}</a></p>
            <p><a href="/join-the-team/">{t.join}</a></p>
            <p><a href={t.contactUrl}>{t.contact}</a></p>
          </div>
          <div>
            <h4>{t.getInTouch}</h4>
            <p><a href="tel:+40317305000">+40 317 305 000</a></p>
            <p><a href="mailto:office@euroanswer.co.uk">office@euroanswer.co.uk</a></p>
            <p>Bucharest · Galati · Skopje</p>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Euroanswer. {t.rights}</span>
          <span>
            <a href="/euroanswer-data-protection-privacy-policy/">{t.privacyPolicy.replace(' (EN)', '')}</a> ·
            <a href="/euroanswer-cookies-policy/">{t.cookies}</a> ·
            <a href="/disclaimer/">{t.disclaimer}</a>
          </span>
        </div>
      </div>
    </footer>

    <script>
      const header = document.querySelector('.site-header');
      const toggle = document.querySelector('.menu-toggle');
      toggle?.addEventListener('click', () => {
        const open = header?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });

      // Derulare lină (Lenis) — doar pe desktop (mouse/touchpad); pe telefon rămâne derularea nativă.
      // Dezactivată pentru vizitatorii care au setat „mai puțină mișcare” în sistem.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        import('lenis').then(({ default: Lenis }) => {
          const lenis = new Lenis({
            lerp: 0.16,           // cât de „moale” e derularea (mai mic = frânare mai lungă). 0.1 → 0.16 = oprire cu ~40% mai rapidă
            wheelMultiplier: 1,
            anchors: { offset: -90 }, // linkurile #ancoră derulează lin și lasă loc pentru meniul fix
            prevent: (node: HTMLElement) => !!node.closest('.lang-dd ul, .track'), // listele/sliderele derulează normal
          });
          const raf = (time: number) => { lenis.raf(time); requestAnimationFrame(raf); };
          requestAnimationFrame(raf);
        });
      }

      // Lista de limbi se închide la click în afara ei sau la Escape
      const langDd = document.querySelector<HTMLDetailsElement>('.lang-dd');
      document.addEventListener('click', (e) => {
        if (langDd?.open && !langDd.contains(e.target as Node)) langDd.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && langDd?.open) { langDd.open = false; langDd.querySelector('summary')?.focus(); }
      });
    </script>
  </body>
</html>
