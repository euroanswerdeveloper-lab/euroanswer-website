---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Euroanswer" description="The page you are looking for doesn’t exist or has moved.">
  <section class="nf">
    <div class="container">
      <img src="/game/icons/raised-eyebrow.svg" alt="" width="96" height="96" />
      <p class="eyebrow">Error 404</p>
      <h1>This customer got lost.</h1>
      <p>The page you’re looking for doesn’t exist or has moved. Let us route you to the right place.</p>
      <div class="links">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/services/" class="btn btn-ghost">Our services</a>
        <a href="/contact/" class="btn btn-ghost">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding: 96px 0 112px; text-align: center; }
  .nf h1 { font-size: clamp(2rem, 4vw, 2.8rem); margin: 8px 0 12px; }
  .nf p { color: var(--muted); max-width: 520px; margin: 0 auto 28px; }
  .nf .eyebrow { margin-top: 16px; }
  .links { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-ghost { border: 1px solid var(--border); color: var(--navy); }
</style>
