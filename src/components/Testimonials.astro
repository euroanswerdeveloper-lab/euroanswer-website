---
import { testimonials } from '../data/testimonials';
import { homeText } from '../i18n/home';
import type { Lang } from '../i18n/ui';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = homeText[lang].testimonials;
---

<section class="testimonials" aria-roledescription="carousel" aria-label={t.title}>
  <div class="container">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{t.title}</h2>

    <div class="slider">
      <div class="track" tabindex="0">
        {testimonials.map((item, i) => (
          <figure class="slide" aria-roledescription="slide" aria-label={`${i + 1} / ${testimonials.length}`}>
            <span class="mark" aria-hidden="true">“</span>
            <blockquote>{item.quote[lang]}</blockquote>
            <figcaption>
              {item.role[lang] && <strong>{item.role[lang]}</strong>}
              {item.link ? <a href={item.link}>{item.industry[lang]}</a> : <span>{item.industry[lang]}</span>}
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="controls">
        <button class="arrow prev" aria-label={t.prev}>←</button>
        <div class="dots">
          {testimonials.map((_, i) => <button class="dot" aria-label={`${t.goTo} ${i + 1}`} data-index={i}></button>)}
        </div>
        <button class="arrow next" aria-label={t.next}>→</button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.testimonials .slider').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('.track')!;
    const slides = [...track.children] as HTMLElement[];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>('.dot')];
    let index = 0;
    let timer: number | undefined;

    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      track.scrollTo({ left: index * track.clientWidth, behavior: 'smooth' });
    };
    const update = () => {
      index = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === index)));
    };

    slider.querySelector('.prev')!.addEventListener('click', () => go(index - 1));
    slider.querySelector('.next')!.addEventListener('click', () => go(index + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(index + 1);
      if (e.key === 'ArrowLeft') go(index - 1);
    });

    // Derulare automată, oprită la hover/focus și pentru cei care preferă mai puțină animație
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => { if (!reduced) timer = window.setInterval(() => go(index + 1), 7000); };
    const stop = () => window.clearInterval(timer);
    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', start);
    slider.addEventListener('focusin', stop);
    slider.addEventListener('focusout', start);
    update();
    start();
  });
</script>

<style>
  .testimonials { background: var(--bg); padding: 88px 0; text-align: center; }
  h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); margin: 0 0 40px; }

  .slider { max-width: 860px; margin: 0 auto; }
  .track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; outline: none; }
  .track::-webkit-scrollbar { display: none; }

  .slide { flex: 0 0 100%; scroll-snap-align: center; margin: 0; padding: 48px 56px 40px; background: #fff; border-top: 4px solid transparent; border-image: var(--gradient-cta) 1; outline: 1px solid var(--border); outline-offset: -1px; box-shadow: 0 18px 40px rgba(7, 16, 52, .07); position: relative; }
  .mark { position: absolute; top: -8px; left: 50%; transform: translateX(-50%); font-family: Georgia, serif; font-size: 7rem; line-height: 1; color: var(--orange); opacity: .18; pointer-events: none; }
  blockquote { margin: 0 0 28px; font-family: var(--font-head); font-size: 1.12rem; font-weight: 400; line-height: 1.7; color: var(--navy); font-style: italic; }
  figcaption { display: flex; flex-direction: column; gap: 2px; font-size: .95rem; }
  figcaption strong { font-family: var(--font-head); color: var(--navy); }
  figcaption a, figcaption span { color: var(--indigo); text-decoration: none; }
  figcaption a:hover { text-decoration: underline; }

  .controls { display: flex; align-items: center; justify-content: center; gap: 20px; margin-top: 32px; }
  .arrow { width: 44px; height: 44px; border: 1px solid var(--border); background: #fff; color: var(--navy); font-size: 1.1rem; cursor: pointer; transition: background .2s, color .2s; }
  .arrow:hover { background: var(--navy); color: #fff; }
  .dots { display: flex; gap: 8px; }
  .dot { width: 10px; height: 10px; padding: 0; border: 0; border-radius: 50%; background: #c5cbe0; cursor: pointer; transition: width .2s, background .2s; }
  .dot[aria-current='true'] { width: 28px; border-radius: 5px; background: var(--indigo); }

  @media (max-width: 640px) {
    .testimonials { padding: 64px 0; }
    .slide { padding: 40px 24px 28px; }
    blockquote { font-size: 1rem; }
  }
</style>
