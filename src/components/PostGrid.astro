---
// Grila de articole folosită de /blog/ și /insights/
import type { CollectionEntry } from 'astro:content';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  posts: CollectionEntry<'blog'>[];
}
const { eyebrow, title, intro, posts } = Astro.props;

// Rezumatul din WordPress se termină uneori cu „[…]” — îl curățăm
const excerpt = (s = '') => s.replace(/\s*\[(&hellip;|…)\]\s*$/, '…').replace(/&hellip;/g, '…');
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<section class="blog-head">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{intro}</p>
  </div>
</section>

<section class="container blog-wrap">
  {posts.length === 0 && <p class="empty">No articles yet — check back soon.</p>}
  <ul class="blog-grid">
    {posts.map((p) => (
      <li class="card">
        <a href={p.data.path} class="card-link">
          {p.data.image
            ? <img src={p.data.image} alt="" loading="lazy" />
            : <div class="img-placeholder"></div>}
          <div class="card-body">
            <p class="card-meta">{fmt(p.data.date)}{p.data.categories[0] && ` · ${p.data.categories[0]}`}</p>
            <h2>{p.data.title}</h2>
            <p class="card-excerpt">{excerpt(p.data.description)}</p>
            <span class="read-more">Read more →</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .blog-head { background: var(--bg-soft); padding: 48px 0 40px; border-bottom: 1px solid var(--border); }
  .blog-head h1 { font-size: clamp(1.8rem, 3vw, 2.4rem); margin: 0 0 8px; }
  .blog-head p:last-child { margin: 0; color: var(--muted); }

  .blog-wrap { padding-top: 40px; padding-bottom: 72px; }
  .empty { color: var(--muted); }
  .blog-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

  .card { border: 1px solid var(--border); background: #fff; transition: box-shadow .2s, transform .2s; }
  .card:hover { box-shadow: 0 10px 24px rgba(7, 16, 52, .08); transform: translateY(-2px); }
  .card-link { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  .card img, .img-placeholder { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; background: var(--bg-soft); }
  .card-body { padding: 16px 18px 18px; display: flex; flex-direction: column; flex: 1; }
  .card-meta { font-size: .8rem; color: var(--muted); margin: 0 0 6px; text-transform: uppercase; letter-spacing: .05em; }
  .card h2 { font-size: 1.05rem; line-height: 1.35; margin: 0 0 8px; color: var(--navy);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card-excerpt { font-size: .92rem; color: var(--muted); margin: 0 0 12px; line-height: 1.55;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .read-more { margin-top: auto; font-family: var(--font-head); font-weight: 600; font-size: .88rem; color: var(--indigo); }

  @media (max-width: 900px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .blog-grid { grid-template-columns: 1fr; } }
</style>
